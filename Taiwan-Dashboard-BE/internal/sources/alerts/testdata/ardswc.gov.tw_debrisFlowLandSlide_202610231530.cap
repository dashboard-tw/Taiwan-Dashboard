    <headline>宜蘭縣土石流及大規模崩塌黃色警戒</headline>
    <description>依據中央氣象署風雨資料研判：計57條土石流潛勢溪流達黃色警戒(相關詳細土石流及大規模崩塌警戒資訊請上土石流及大規模崩塌防災資訊網( https://246.ardswc.gov.tw/ )查詢)</description>
    <instruction>請隨時觀察環境變化，留意最新訊息，做好疏散避難準備及保持聯絡管道暢通，並與當地避難處所保持聯繫，有關當地避難處所相關聯絡資訊，請詳土石流疏散避難圖。</instruction>
    <web>https://246.ardswc.gov.tw/Map/DebrisAlertList</web>
    <parameter>
      <valueName>alert_title</valueName>
      <value>土石流及大規模崩塌黃色警戒</value>
    </parameter>
    <parameter>
      <valueName>severity_level</valueName>
      <value>黃色警戒</value>
    </parameter>
    <parameter>
      <valueName>alert_color</valueName>
      <value>黃色</value>
    </parameter>
    <parameter>
      <valueName>debrisID</valueName>
      <value>宜縣DF051,宜縣DF052,宜縣DF053,宜縣DF054,宜縣DF055,宜縣DF056,宜縣DF057,宜縣DF058,宜縣DF059,宜縣DF060,宜縣DF061,宜縣DF062,宜縣DF063,宜縣DF064,宜縣DF065,宜縣DF066,宜縣DF067,宜縣DF068,宜縣DF069,宜縣DF070,宜縣DF071,宜縣DF072,宜縣DF073,宜縣DF074,宜縣DF075,宜縣DF076,宜縣DF077,宜縣DF078,宜縣DF079,宜縣DF080,宜縣DF081,宜縣DF082,宜縣DF083,宜縣DF084,宜縣DF085,宜縣DF086,宜縣DF087,宜縣DF088,宜縣DF089,宜縣DF090,宜縣DF091,宜縣DF092,宜縣DF093,宜縣DF094,宜縣DF095,宜縣DF096,宜縣DF097,宜縣DF098,宜縣DF099,宜縣DF139,宜縣DF143,宜縣DF144,宜縣DF146,宜縣DF147,宜縣DF149,宜縣DF150,宜縣DF152</value>
    </parameter>
    <parameter>
      <valueName>LandslideID</valueName>
      <value />
    </parameter>
    <parameter>
      <valueName>disaster_id</valueName>
      <value>115L</value>
    </parameter>
    <area>
      <areaDesc>宜蘭縣大同鄉太平村</areaDesc>
      <geocode>
        <valueName>Taiwan_Geocode_103</valueName>
        <value>1000211-007</value>
      </geocode>
    </area>
    <area>
      <areaDesc>宜蘭縣大同鄉四季村</areaDesc>
      <geocode>
        <valueName>Taiwan_Geocode_103</valueName>
        <value>1000211-008</value>
      </geocode>
    </area>
    <area>
      <areaDesc>宜蘭縣大同鄉松羅村</areaDesc>
      <geocode>
        <valueName>Taiwan_Geocode_103</valueName>
        <value>1000211-003</value>
      </geocode>
    </area>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
