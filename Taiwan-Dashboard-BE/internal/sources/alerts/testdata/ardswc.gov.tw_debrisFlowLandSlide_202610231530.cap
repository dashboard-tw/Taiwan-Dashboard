    </parameter>
    <parameter>
      <valueName>alert_color</valueName>
      <value>黃色</value>
    </parameter>
    <parameter>
      <valueName>debrisID</valueName>
      <value>桃市DF022,桃市DF023,桃市DF024,桃市DF025,桃市DF026,桃市DF027,桃市DF028,桃市DF029,桃市DF030,桃市DF031,桃市DF032,桃市DF033,桃市DF034,桃市DF035,桃市DF036,桃市DF037,桃市DF038,桃市DF039,桃市DF040,桃市DF041,桃市DF042,桃市DF043,桃市DF044,桃市DF045,桃市DF046,桃市DF047,桃市DF048,桃市DF049,桃市DF050,桃市DF051,桃市DF053</value>
    </parameter>
    <parameter>
      <valueName>LandslideID</valueName>
      <value>桃市LL004</value>
    </parameter>
    <parameter>
      <valueName>disaster_id</valueName>
      <value>115L</value>
    </parameter>
    
    
    
    
    
    
    
    
    
    
